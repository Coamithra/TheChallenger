# The Challenger - configuration
#
# Copy to `.env` (same folder as challenger_hook.py) and edit. Every setting is
# optional except CHALLENGER_PROJECTS: with an empty project list the hook is
# installed but inert, waving every response through.
#
# Real environment variables win over this file, so you can override any value
# for a single session without editing anything.


# --- Which projects get edited -----------------------------------------------
#
# Absolute project roots, separated by your platform's path separator
# (";" on Windows, ":" on macOS/Linux). A session is edited when its cwd is the
# root itself or anything beneath it, so git worktrees nested under a root are
# covered automatically. Matching is case-insensitive on Windows.
#
# Everything not listed here is waved through in ~70ms (interpreter startup),
# which is why the hook can safely be registered globally.
#
# Windows:
CHALLENGER_PROJECTS=C:\code\my-project;C:\code\another-project
# macOS/Linux:
# CHALLENGER_PROJECTS=/home/me/code/my-project:/home/me/code/another-project


# --- Gates -------------------------------------------------------------------

# Responses shorter than this are never sent to the editor. Raise it if short
# status updates are being rewritten; lower it to catch more. Default 1000.
# CHALLENGER_MIN_CHARS=1000

# Only sessions whose model id starts with this prefix are edited; the hook
# reads the model from the session transcript. Set to an empty-ish value like
# "claude-" to cover every Claude model. Default claude-opus-5.
# CHALLENGER_TARGET_MODEL=claude-opus-5

# How many times the editor may ask the coding agent for clarification before
# the original response ships unedited. Default 2.
# CHALLENGER_MAX_ASK_ROUNDS=2


# --- Editor backend ----------------------------------------------------------

# "codex" (OpenAI, via the vendored bridge) or "claude" (Anthropic, via the
# claude CLI). Default codex: a non-Claude editor does not share the stylistic
# blind spots of the model it is editing, and it is measurably faster.
# CHALLENGER_CRITIC=codex

# --- codex backend ---
# Requires the Codex CLI on PATH (`npm install -g @openai/codex`) and a valid
# `codex login`. Auth failure fails open, i.e. your response ships unedited.
# CHALLENGER_CODEX_MODEL=gpt-5.6-sol
# CHALLENGER_CODEX_EFFORT=high
# Path to the bridge script. Defaults to the vendored copy in this repo; point
# it elsewhere only if you keep your own.
# CHALLENGER_CODEX_BRIDGE=/path/to/ask_codex.py

# --- claude backend ---
# Uses `claude -p` headlessly. It is passed critic-settings.json
# ({"disableAllHooks": true}) so the editor cannot re-trigger this same hook.
# CHALLENGER_CRITIC_MODEL=claude-fable-5
# CHALLENGER_CLAUDE_BIN=claude


# --- Plumbing ----------------------------------------------------------------

# Seconds before the editor call is abandoned (and the response ships unedited).
# Keep it below the hook timeout in ~/.claude/settings.json, which defaults to 360.
# CHALLENGER_TIMEOUT=300

# Where decisions are logged. Every enabled project logs to the same file.
# Self-trims past 512KB. Default: hook-debug.log next to challenger_hook.py.
# CHALLENGER_LOG=/path/to/hook-debug.log

# The editor's instructions. Edit critic-prompt.md in place to change the house
# style; point this elsewhere to keep several prompts around.
# CHALLENGER_PROMPT=/path/to/critic-prompt.md
